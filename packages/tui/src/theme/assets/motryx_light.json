{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "motryxBg": "#F8FAF6",
    "motryxPanel": "#FFFFFF",
    "motryxElement": "#E8EFEA",
    "motryxMenu": "#FFFFFF",
    "motryxPrimary": "#007D65",
    "motryxSecondary": "#4A5D58",
    "motryxGold": "#A98234",
    "motryxCream": "#F8FAF6",
    "motryxText": "#10241F",
    "motryxTextMuted": "#53645E",
    "motryxTextTertiary": "#7A8882",
    "motryxBorder": "#D8E3DD",
    "motryxGrid": "#E8EFEA",
    "motryxError": "#B94B5A",
    "motryxSelectedText": "#FFFFFF",
    "motryxDiffAddedBg": "#E4F2ED",
    "motryxDiffRemovedBg": "#F6E6E9",
    "motryxDiffContextBg": "#FFFFFF"
  },
  "theme": {
    "primary": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "secondary": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "accent": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "error": { "light": "motryxError", "dark": "motryxError" },
    "warning": { "light": "motryxError", "dark": "motryxError" },
    "success": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "info": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "text": { "light": "motryxText", "dark": "motryxText" },
    "textMuted": { "light": "motryxTextMuted", "dark": "motryxTextMuted" },
    "selectedListItemText": { "light": "motryxSelectedText", "dark": "motryxSelectedText" },
    "background": { "light": "motryxBg", "dark": "motryxBg" },
    "backgroundPanel": { "light": "motryxPanel", "dark": "motryxPanel" },
    "backgroundElement": { "light": "motryxElement", "dark": "motryxElement" },
    "backgroundMenu": { "light": "motryxMenu", "dark": "motryxMenu" },
    "border": { "light": "motryxBorder", "dark": "motryxBorder" },
    "borderActive": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "borderSubtle": { "light": "motryxGrid", "dark": "motryxGrid" },
    "diffAdded": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "diffRemoved": { "light": "motryxError", "dark": "motryxError" },
    "diffContext": { "light": "motryxTextTertiary", "dark": "motryxTextTertiary" },
    "diffHunkHeader": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "diffHighlightAdded": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "diffHighlightRemoved": { "light": "motryxError", "dark": "motryxError" },
    "diffAddedBg": { "light": "motryxDiffAddedBg", "dark": "motryxDiffAddedBg" },
    "diffRemovedBg": { "light": "motryxDiffRemovedBg", "dark": "motryxDiffRemovedBg" },
    "diffContextBg": { "light": "motryxDiffContextBg", "dark": "motryxDiffContextBg" },
    "diffLineNumber": { "light": "motryxTextTertiary", "dark": "motryxTextTertiary" },
    "diffAddedLineNumberBg": { "light": "motryxDiffAddedBg", "dark": "motryxDiffAddedBg" },
    "diffRemovedLineNumberBg": { "light": "motryxDiffRemovedBg", "dark": "motryxDiffRemovedBg" },
    "markdownText": { "light": "motryxText", "dark": "motryxText" },
    "markdownHeading": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "markdownLink": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "markdownLinkText": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "markdownCode": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "markdownBlockQuote": { "light": "motryxTextMuted", "dark": "motryxTextMuted" },
    "markdownEmph": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "markdownStrong": { "light": "motryxText", "dark": "motryxText" },
    "markdownHorizontalRule": { "light": "motryxBorder", "dark": "motryxBorder" },
    "markdownListItem": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "markdownListEnumeration": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "markdownImage": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "markdownImageText": { "light": "motryxTextMuted", "dark": "motryxTextMuted" },
    "markdownCodeBlock": { "light": "motryxText", "dark": "motryxText" },
    "syntaxComment": { "light": "motryxTextTertiary", "dark": "motryxTextTertiary" },
    "syntaxKeyword": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "syntaxFunction": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "syntaxVariable": { "light": "motryxText", "dark": "motryxText" },
    "syntaxString": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "syntaxNumber": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "syntaxType": { "light": "motryxSecondary", "dark": "motryxSecondary" },
    "syntaxOperator": { "light": "motryxPrimary", "dark": "motryxPrimary" },
    "syntaxPunctuation": { "light": "motryxTextMuted", "dark": "motryxTextMuted" }
  }
}
